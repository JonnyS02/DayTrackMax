Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ServerSignature Off

<IfModule mod_rewrite.c>
	Options +FollowSymlinks
	RewriteEngine On

	# Keep the API on CodeIgniter while React owns all other application routes.
	RewriteRule ^(api(?:/.*)?)$ index.php/$1 [L,NC,QSA]

	# Serve generated frontend files and backend public files directly.
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# Missing assets must return 404 instead of the React application shell.
	RewriteRule ^assets/ - [R=404,L]
	RewriteRule \.(css|js|mjs|png|jpe?g|gif|svg|ico|webp|woff2?)$ - [R=404,L]

	# React Router handles every remaining frontend route.
	RewriteRule ^ index.html [L,QSA]
</IfModule>
