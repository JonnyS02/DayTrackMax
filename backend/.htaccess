Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https:"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
    Header always set Referrer-Policy "no-referrer"
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # CodeIgniter owns the complete API namespace and validates its routes and methods.
    RewriteRule ^api(?:/(.*))?$ public/index.php/api/$1 [END,NC,QSA]

    # Only known React pages may receive the application shell.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteRule ^(?:|login/?|test-login/?|register/?|verify-email/?|forgot-password/?|locked/?|reset-password/?|profile/?)$ public/index.html [END]

    # Only generated frontend assets and intentional public metadata are files on the web.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteRule ^(assets/[A-Za-z0-9_-][A-Za-z0-9_.-]*\.(?:css|js|mjs|png|jpe?g|gif|svg|ico|webp|woff2?)|favicon\.svg|og\.png|robots\.txt)$ public/$1 [END,NC]

    # Everything else stays outside the public surface, whether the file exists or not.
    RewriteRule ^ - [R=404,L]
</IfModule>
