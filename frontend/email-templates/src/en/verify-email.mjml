<mjml lang="en">
  <mj-head>
    <mj-include path="../partials/head.mjml" />
  </mj-head>
  <mj-body background-color="#fffaf4" width="600px">
    <mj-wrapper padding="32px 16px">
      <mj-include path="../partials/header.mjml" />
      <mj-section background-color="#ffffff" border-radius="0 0 24px 24px" padding="36px 28px">
        <mj-column>
          <mj-text mj-class="title">Confirm your email</mj-text>
          <mj-text>Hello {{user_name}}, {{verification_message}}</mj-text>
          <mj-button href="{{verification_url}}">Confirm email</mj-button>
          <mj-text mj-class="muted" padding="20px 0 0">The link is valid for {{expires_in}}.</mj-text>
        </mj-column>
      </mj-section>
      <mj-include path="../partials/footer-en.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
