<mjml lang="en">
  <mj-head>
    <mj-include path="../partials/head.mjml" />
  </mj-head>
  <mj-body background-color="#fffaf4" width="600px">
    <mj-wrapper padding="32px 16px">
      <mj-include path="../partials/header.mjml" />
      <mj-section background-color="#ffffff" border-radius="0 0 24px 24px" padding="36px 28px">
        <mj-column>
          <mj-text mj-class="title">Reset your password</mj-text>
          <mj-text>Hello {{user_name}}, {{reset_message}}</mj-text>
          <mj-button href="{{reset_url}}">Set new password</mj-button>
          <mj-text mj-class="muted" padding="20px 0 0">{{reset_note}}</mj-text>
        </mj-column>
      </mj-section>
      <mj-include path="../partials/footer-en.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
